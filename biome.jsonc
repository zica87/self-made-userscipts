{
    "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": {
        "ignoreUnknown": false,
        "includes": ["**"]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noRedundantUseStrict": "off"
            },
            "complexity": {
                "useArrowFunction": "off"
            }
        }
    },
    "formatter": {
        "enabled": false
    },
    "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
